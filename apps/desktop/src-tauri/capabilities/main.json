{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Closed-set Level 0 through Level 3 security workflow commands from the local main webview only.",
  "local": true,
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "allow-get-foundation-status",
    "allow-get-engine-status",
    "allow-authorize-repository-target",
    "allow-inspect-repository-target",
    "allow-create-repository-scan",
    "allow-get-repository-inventory",
    "allow-inspect-file-target",
    "allow-authorize-file-target",
    "allow-create-file-scan",
    "allow-get-file-analysis",
    "allow-preview-installed-applications",
    "allow-authorize-installed-applications",
    "allow-create-installed-application-scan",
    "allow-get-installed-application-inventory",
    "allow-get-installed-application",
    "allow-get-vulnerability-provider-status",
    "allow-refresh-public-vulnerability-data",
    "allow-create-synthetic-scan",
    "allow-get-scan",
    "allow-list-scans",
    "allow-get-scan-progress",
    "allow-cancel-scan",
    "allow-list-findings",
    "allow-get-finding",
    "allow-generate-report"
  ]
}
