{
  "name": "edy-verdict-foundation",
  "private": true,
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": "24.20.0", "pnpm": "11.25.0" },
  "scripts": {
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "lint": "pnpm --dir apps/desktop lint",
    "test": "node --test tests/*.test.mjs && pnpm --dir apps/desktop test",
    "build": "pnpm --dir apps/desktop build",
    "test:level2-native": "node tests/native/level2-e2e.mjs",
    "test:level3-native": "node tests/native/level3-e2e.mjs",
    "test:level4-native": "node tests/native/level4-e2e.mjs",
    "test:level5-native": "node tests/native/level5-e2e.mjs",
    "test:level6-native": "node tests/native/level6-e2e.mjs",
    "test:level7-native": "node tests/native/level7-e2e.mjs"
  }
}
