{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:edy-verdict:engine-receipt:v2",
  "title":"EDY VERDICT Engine Receipt V2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","engine_id","version","manifest_sha256","entrypoint_sha256","artifact_set_sha256","promoted_at","state"],
  "properties":{
    "schema_version":{"const":2},
    "engine_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "version":{"type":"string","minLength":1,"maxLength":64,"not":{"const":"latest"}},
    "manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "entrypoint_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "promoted_at":{"type":["string","null"],"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "state":{"enum":["staged","ready","revoked","tampered","superseded"]}
  },
  "$comment":"Stored outside the engine directory. Semantic state/timestamp and integrity checks are mandatory."
}
