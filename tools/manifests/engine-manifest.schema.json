{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edy-verdict:engine-manifest:v2",
  "title": "EDY VERDICT Engine Manifest Contract V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","identity","source","artifact","provenance","license","extraction","process","version_probe","review"],
  "properties": {
    "schema_version": {"const":2},
    "identity": {
      "type":"object","additionalProperties":false,
      "required":["id","version","platform","architecture"],
      "properties": {
        "id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "version":{"type":"string","minLength":1,"maxLength":64,"not":{"const":"latest"}},
        "platform":{"enum":["windows","linux"]},
        "architecture":{"enum":["x86_64","aarch64"]}
      }
    },
    "source": {
      "type":"object","additionalProperties":false,
      "required":["official_source","release_url","asset_url","asset_name","asset_size","archive_sha256"],
      "properties": {
        "official_source":{"type":"string","pattern":"^https://","maxLength":2048},
        "release_url":{"type":"string","pattern":"^https://","maxLength":2048},
        "asset_url":{"type":"string","pattern":"^https://","maxLength":2048},
        "asset_name":{"type":"string","minLength":1,"maxLength":255},
        "asset_size":{"type":"integer","minimum":1,"maximum":536870912},
        "archive_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "artifact": {
      "type":"object","additionalProperties":false,
      "required":["format","entrypoint","entrypoint_size","executable_sha256","auxiliary_hashes","closed_set"],
      "properties": {
        "format":{"enum":["zip","tar_gz","raw_executable"]},
        "entrypoint":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^[A-Za-z0-9._/-]+$"},
        "entrypoint_size":{"type":"integer","minimum":1,"maximum":2147483648},
        "executable_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "auxiliary_hashes":{
          "type":"array","maxItems":99999,
          "items":{
            "type":"object","additionalProperties":false,
            "required":["relative_path","sha256","size"],
            "properties":{
              "relative_path":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^[A-Za-z0-9._/-]+$"},
              "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
              "size":{"type":"integer","minimum":1,"maximum":2147483648}
            }
          }
        },
        "closed_set":{"const":true}
      }
    },
    "provenance": {
      "type":"object","additionalProperties":false,"required":["evidence"],
      "properties":{
        "evidence":{
          "type":"array","minItems":1,"maxItems":32,
          "items":{
            "type":"object","additionalProperties":false,
            "required":["type","status","source","subject"],
            "properties":{
              "type":{"enum":["published_checksum","source_commit","signed_commit","signed_tag","authenticode","sigstore","slsa","in_toto","reproducible_build"]},
              "status":{"enum":["verified","present_unverified","unavailable","failed"]},
              "source":{"type":"string","pattern":"^https://","maxLength":2048},
              "subject":{"type":"string","minLength":1,"maxLength":2048},
              "digest":{
                "type":"object","additionalProperties":false,"required":["algorithm","value"],
                "properties":{
                  "algorithm":{"enum":["sha256","git_sha1"]},
                  "value":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
                }
              },
              "verifier":{"type":"string","minLength":1,"maxLength":128},
              "verified_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
            }
          }
        }
      }
    },
    "license": {
      "type":"object","additionalProperties":false,
      "required":["spdx","source","redistribution_policy","notice_required"],
      "properties":{
        "spdx":{"type":"string","minLength":1,"maxLength":128},
        "source":{"type":"string","pattern":"^https://","maxLength":2048},
        "redistribution_policy":{"enum":["permitted","review_required","prohibited"]},
        "notice_required":{"type":"boolean"}
      }
    },
    "extraction": {
      "type":"object","additionalProperties":false,
      "required":["max_archive_bytes","max_expanded_bytes","max_entries","allowed_formats","reject_absolute_paths","reject_parent_traversal","reject_ads","reject_links","reject_case_collisions","reject_duplicate_paths"],
      "properties":{
        "max_archive_bytes":{"type":"integer","minimum":1,"maximum":536870912},
        "max_expanded_bytes":{"type":"integer","minimum":1,"maximum":2147483648},
        "max_entries":{"type":"integer","minimum":1,"maximum":100000},
        "allowed_formats":{"type":"array","minItems":1,"maxItems":1,"uniqueItems":true,"items":{"enum":["zip","tar_gz","raw_executable"]}},
        "reject_absolute_paths":{"const":true},
        "reject_parent_traversal":{"const":true},
        "reject_ads":{"const":true},
        "reject_links":{"const":true},
        "reject_case_collisions":{"const":true},
        "reject_duplicate_paths":{"const":true}
      }
    },
    "process": {
      "type":"object","additionalProperties":false,
      "required":["timeout_ms","stdout_limit_bytes","stderr_limit_bytes","stdin_limit_bytes","kill_process_tree","shell","network_policy"],
      "properties":{
        "timeout_ms":{"type":"integer","minimum":1,"maximum":600000},
        "stdout_limit_bytes":{"type":"integer","minimum":1,"maximum":16777216},
        "stderr_limit_bytes":{"type":"integer","minimum":1,"maximum":4194304},
        "stdin_limit_bytes":{"type":"integer","minimum":0,"maximum":1048576},
        "kill_process_tree":{"const":true},
        "shell":{"const":false},
        "network_policy":{"enum":["deny","probe_only"]}
      }
    },
    "version_probe": {
      "type":"object","additionalProperties":false,
      "required":["args","expected_exit_codes","expected_output","output_stream","network","timeout_ms"],
      "properties":{
        "args":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._-]+$"}},
        "expected_exit_codes":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"integer","minimum":-255,"maximum":255}},
        "expected_output":{"type":"string","minLength":1,"maxLength":256},
        "output_stream":{"enum":["stdout","stderr","either"]},
        "network":{"type":"boolean"},
        "timeout_ms":{"type":"integer","minimum":1,"maximum":600000}
      }
    },
    "review": {
      "type":"object","additionalProperties":false,
      "required":["reviewed_at","reviewed_by_role","policy_version"],
      "properties":{
        "reviewed_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "reviewed_by_role":{"const":"jr_orchestrator"},
        "policy_version":{"type":"string","minLength":1,"maxLength":64}
      }
    }
  },
  "$comment": "V2 ACTIVE. Semantic validation in Rust is mandatory in addition to this structural schema."
}
